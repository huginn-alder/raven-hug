// secrets.h.example: copy this file to secrets.h and fill in your own values.
// secrets.h is in .gitignore and must never be committed or shared.

// WiFi network the bird joins (required). The ESP32 is 2.4 GHz only.
#define WIFI_SSID   "your-wifi-name"
// Password for that network.
#define WIFI_PASS   "your-wifi-password"

// Optional extra networks (second house, phone hotspot). The bird joins
// whichever known one is in range. Delete or comment out pairs you don't need.
// Name of a second network.
#define WIFI_SSID_2 "second-wifi-name"
// Password of the second network.
#define WIFI_PASS_2 "second-wifi-password"
// Name of a third network.
#define WIFI_SSID_3 "third-wifi-name"
// Password of the third network.
#define WIFI_PASS_3 "third-wifi-password"

// The bird's own name. Used as the OTA/mDNS hostname (name.local), the status
// page title, and the "device" field in every POST. Letters, digits and
// hyphens only. Give each bird on the same network a DIFFERENT name: this is
// what keeps two birds from taking each other's over-the-air updates.
#define DEVICE_NAME "my-bird"

// Full URL the bird POSTs each hug to. "https://" uses TLS (certificate is not
// verified, see the TODO in the sketch); "http://" is plain text, fine for a
// receiver on your own LAN. Put a key in the query string here if your server
// wants it there, e.g. "https://example.com/api/touch?token=abc123".
#define TOUCH_URL   "http://192.168.1.50:8080/touch"

// Optional: an auth header sent with every POST. Name of the header...
#define TOUCH_AUTH_HEADER "X-Touch-Key"
// ...and its value (the shared key your receiver checks). Remove both lines
// if your server authenticates some other way (such as a key inside TOUCH_URL).
#define TOUCH_AUTH_VALUE  "change-me-to-a-long-random-string"

// Password for over-the-air updates. Pick any random string; you pass it to
// the uploader. Leave this line out to disable OTA (USB flashing only).
#define OTA_PASS    "pick-a-random-ota-password"
